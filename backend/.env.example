# Application
APP_NAME=WapiSend
DEBUG=false
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wapisend

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Meta WhatsApp Cloud API
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here
# App Secret from Meta App Dashboard > Settings > Basic — used to verify X-Hub-Signature-256 on incoming webhooks
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Cloudflare R2
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_NAME=wapisend-media
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@wapisend.com

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","https://app.wapisend.com"]
